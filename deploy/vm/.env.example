# VM origin configuration. Copy to .env and fill in. Never commit .env.

# Image (multi-arch; works on Oracle Ampere arm64 and amd64).
IMAGE=ghcr.io/syed-waleed-ahmed/niche-finetuned-model:latest
REPLICA_NAME=oracle-vm

# Model release: replace with `fastapi-assistant export env model-release.json`.
MODEL_VERSION=base-tinyllama-q4km
ENGINE_BACKEND=llamacpp
GGUF_REPO_ID=TheBloke/TinyLlama-1.1B-Chat-v1.0-GGUF
GGUF_FILENAME=tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf
GGUF_REVISION=52e7645ba7c309695bec7ac98f4f005b139cf465
LLAMACPP_CHAT_FORMAT=zephyr
FINETUNED_WEIGHTS=false

# Must match the Cloudflare Worker's ORIGIN_SHARED_SECRET.
ORIGIN_SHARED_SECRET=
# Same Neon database as Cloud Run (per-user keys and usage are shared).
DATABASE_URL=
METRICS_TOKEN=
SENTRY_DSN=

# Cloudflare Zero Trust > Networks > Tunnels > create tunnel > copy the token.
# Route a public hostname (e.g. origin-vm.example.com) to http://app:8080.
CLOUDFLARE_TUNNEL_TOKEN=

# Grafana Cloud (stack details page). One access-policy token with
# metrics:write and logs:write scopes.
GRAFANA_PROM_URL=https://prometheus-prod-XX-prod-REGION.grafana.net/api/prom/push
GRAFANA_PROM_USER=
GRAFANA_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USER=
GRAFANA_CLOUD_TOKEN=
