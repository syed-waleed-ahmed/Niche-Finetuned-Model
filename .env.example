# Environment configuration TEMPLATE.
#
# Copy this file to `.env` and adjust for your machine or deployment:
#   cp .env.example .env
#
# `.env` is git-ignored and loaded automatically at startup. Every value below is
# optional; the application falls back to the documented defaults when a variable
# is unset. In deployments, take the model section from
# `fastapi-assistant export env model-release.json`.

# --- Model and backend ------------------------------------------------------
BASE_MODEL_NAME=TinyLlama/TinyLlama-1.1B-Chat-v1.0
MODEL_VERSION=dev
# transformers (torch + LoRA adapter; dev/GPU) | llamacpp (GGUF on CPU; production)
# | remote (an OpenAI-compatible server such as vLLM)
ENGINE_BACKEND=transformers
# LoRA adapter for the transformers backend: OUTPUT_DIR locally, or a pinned Hub repo.
# ADAPTER_REPO_ID=your-user/fastapi-assistant-lora
# ADAPTER_REVISION=v2026.11.12-abc1234
# GGUF for the llamacpp backend: a local file or a pinned Hub file.
# GGUF_PATH=./outputs/gguf/model-Q4_K_M.gguf
# GGUF_REPO_ID=TheBloke/TinyLlama-1.1B-Chat-v1.0-GGUF
# GGUF_FILENAME=tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf
# GGUF_REVISION=52e7645ba7c309695bec7ac98f4f005b139cf465
# LLAMACPP_CHAT_FORMAT=zephyr      # only for GGUFs without an embedded template
# FINETUNED_WEIGHTS=false          # report whether the GGUF/remote model is fine-tuned
# REMOTE_BASE_URL=http://vllm:8000
# REMOTE_API_KEY=

# --- Hugging Face -----------------------------------------------------------
# HF_TOKEN=
# HF_HOME=

# --- HTTP service -----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Single static key. With DATABASE_URL set, per-user keys are also accepted.
# API_KEY=change-me
# Explicit origins in production (credentials are never allowed).
CORS_ALLOW_ORIGINS=["*"]
WARMUP_ON_STARTUP=true
# Set on every origin behind the Cloudflare Worker (same value as the Worker).
# ORIGIN_SHARED_SECRET=
# METRICS_TOKEN=

# --- Back-pressure ----------------------------------------------------------
MAX_CONCURRENCY=1
MAX_QUEUE=8
QUEUE_TIMEOUT_S=30
GENERATION_TIMEOUT_S=120

# --- Persistence (Neon or any Postgres with pgvector) -----------------------
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# STORE_TRANSCRIPTS=false

# --- Retrieval (RAG) ----------------------------------------------------------
RAG_ENABLED=false
# RAG_BACKEND=local                # local (NumPy index file) | pgvector
# RAG_INDEX_DIR=./outputs/rag_index

# --- Observability ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
# SENTRY_DSN=

# --- Generation defaults (bounded and validated) ----------------------------
MODEL_MAX_NEW_TOKENS=256
MODEL_TEMPERATURE=0.4
MODEL_TOP_P=0.9
MODEL_REPETITION_PENALTY=1.05

# --- Training hyperparameters -----------------------------------------------
BATCH_SIZE=2
GRADIENT_ACCUMULATION_STEPS=4
NUM_EPOCHS=3
LEARNING_RATE=0.0002
MAX_SEQ_LENGTH=512
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
LORA_TARGET_MODULES=["q_proj","k_proj","v_proj","o_proj"]

# --- Paths (override in containers/deployments) -----------------------------
# DATA_DIR=./data
# OUTPUT_DIR=./outputs/fastapi_tinyllama_lora
