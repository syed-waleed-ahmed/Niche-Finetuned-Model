# Served by Cloudflare Workers Static Assets (applies to the UI files only; API
# responses get their headers from the Worker and the origin).
#
# Content-Security-Policy:
#   - scripts, styles, fonts and images come only from this site (the build emits no
#     inline script or style); data: images cover inline SVG icons.
#   - connect-src allows any https API because Settings lets a user point the UI at
#     another deployment, plus localhost for local development.
#   - img-src stays strict on purpose: a model answer cannot embed a remote image
#     (a tracking pixel) through markdown.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https: http://localhost:* http://127.0.0.1:*; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Hashed bundles never change, so browsers may cache them forever; the HTML shell is
# revalidated on every load.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/
  Cache-Control: no-cache
