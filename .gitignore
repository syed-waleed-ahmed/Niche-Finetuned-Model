# ---- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/

# ---- Tooling caches and reports ---------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.cache/
.ipynb_checkpoints/

# ---- Local environment and secrets ------------------------------------------
.env
.env.*
!.env.example
.claude/settings.local.json

# ---- Generated artifacts (regenerable) --------------------------------------
# Model build artifacts (adapters, checkpoints, local RAG index): `make train`, `make rag-index`.
outputs/
# Hugging Face model cache, if kept in-repo.
.hf_cache/
# Local training-pipeline output (kaggle/pipeline.py run outside Kaggle) and CI scratch.
kaggle-out/
out/
# Per-run eval reports and logs (`make eval`, `make eval-rag`); the committed
# baselines live next to them in eval/.
eval/report*.json
eval/report*.md
eval/.*.log
# Rendered Cloud Run manifest (release.yml renders deploy/cloudrun/service.yaml).
service.rendered.yaml
# Wrangler local state (also covered by deploy/cloudflare-worker/.gitignore).
.wrangler/
# Knowledge-graph outputs are tracked; only the regenerable cache is ignored.
graphify-out/cache/

# ---- Logs, editors, OS noise -------------------------------------------------
*.log
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
# Generated by web/scripts/notices.mjs on every web build.
web/public/THIRD_PARTY_NOTICES.txt

# ---- Documentation site ------------------------------------------------------
# `mkdocs build` output and a local virtual environment for the docs toolchain.
site/
.docs-venv/
