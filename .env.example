# Copy to `.env` and adjust. All values are optional; sensible defaults apply.

# --- Base model -------------------------------------------------------------
BASE_MODEL_NAME=TinyLlama/TinyLlama-1.1B-Chat-v1.0

# --- HTTP service -----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# If set, POST /generate requires a matching `X-API-Key` header.
# API_KEY=change-me
# JSON list of allowed CORS origins. Use explicit origins in production.
CORS_ALLOW_ORIGINS=["*"]
# Load the model at startup (true) or lazily on first request (false).
WARMUP_ON_STARTUP=true

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# Emit structured JSON logs (recommended in production).
LOG_JSON=false

# --- Generation defaults (bounded and validated) ----------------------------
MODEL_MAX_NEW_TOKENS=256
MODEL_TEMPERATURE=0.4
MODEL_TOP_P=0.9
MODEL_REPETITION_PENALTY=1.05

# --- Training hyperparameters -----------------------------------------------
BATCH_SIZE=2
GRADIENT_ACCUMULATION_STEPS=4
NUM_EPOCHS=3
LEARNING_RATE=0.0002
MAX_SEQ_LENGTH=512
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
LORA_TARGET_MODULES=["q_proj","v_proj"]

# --- Paths (override in containers/deployments) -----------------------------
# DATA_DIR=./data
# OUTPUT_DIR=./outputs/fastapi_tinyllama_lora
